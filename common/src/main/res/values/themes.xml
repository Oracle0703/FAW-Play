<resources>
    <style name="Theme.Xcertplay" parent="android:Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#A6C8FF</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#0C111B</item>
        <item name="android:statusBarColor">#0C111B</item>
        <item name="android:windowBackground">#0C111B</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.AutunnCarPlay" parent="Theme.Xcertplay">
        <item name="android:windowDisablePreview">true</item>
        <!-- The launcher icon is a task handoff. A fade exposes the software task/cover between
             the vehicle desktop and the retained CarPlay surface. -->
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <style name="Animation.AutunnCarPlay" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/carplay_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/carplay_hold</item>
        <item name="android:activityCloseEnterAnimation">@anim/carplay_hold</item>
        <item name="android:activityCloseExitAnimation">@anim/carplay_exit</item>
        <item name="android:taskOpenEnterAnimation">@anim/carplay_enter</item>
        <item name="android:taskOpenExitAnimation">@anim/carplay_hold</item>
        <item name="android:taskCloseEnterAnimation">@anim/carplay_hold</item>
        <item name="android:taskCloseExitAnimation">@anim/carplay_exit</item>
        <item name="android:taskToFrontEnterAnimation">@anim/carplay_enter</item>
        <item name="android:taskToFrontExitAnimation">@anim/carplay_hold</item>
        <item name="android:taskToBackEnterAnimation">@anim/carplay_hold</item>
        <item name="android:taskToBackExitAnimation">@anim/carplay_exit</item>
    </style>
    <style name="Theme.AutunnEntry" parent="android:Theme.NoDisplay">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <style name="Theme.AutunnSettings" parent="Theme.Xcertplay">
        <item name="android:windowDisablePreview">true</item>
    </style>
    <style name="Theme.AdbCluster" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
